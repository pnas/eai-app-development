# ==============================================================================
# Environment Configuration for Decoupled Streamlit Agent Stack (Podman / Docker)
# ==============================================================================

# Operation Mode: Set to "true" for zero-cost offline mock execution (default),
# or "false" to use live frontier model APIs.
AGENT_MOCK_MODE=true

# Default Provider for Streamlit UI: mock | openai | anthropic | gemini
AGENT_DEFAULT_PROVIDER=mock

# Architecture Mode for Streamlit UI: remote (Pattern B Decoupled) | local (Pattern A In-Process)
STREAMLIT_AGENT_MODE=remote

# Internal Container Network Backend URL
AGENT_BACKEND_URL=http://backend:8000

# Regulatory Resources Directory (inside container)
RESOURCES_DIR=/app/docs/resources

# ------------------------------------------------------------------------------
# Optional Provider API Keys (leave blank when AGENT_MOCK_MODE=true)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
