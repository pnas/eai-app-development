# Telekom Advanced AI Integration - Environment Variables Template
# Copy this file to .env (or python/.env) and populate with your API credentials.

# OpenAI API Key (Required for OpenAI models, e.g., gpt-4.1-mini, gpt-4o, gpt-6-astra)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required for Anthropic Claude models, e.g., claude-haiku-5-5, claude-sonnet-5-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Required for Gemini models, e.g., gemini-3.8-flash, gemini-2.0-flash)
# Note: GEMINI_API_KEY and GOOGLE_API_KEY are automatically synchronized across all backends.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# OpenRouter API Key (Optional: for multi-model unified gateway routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Gateway / Telemetry Configurations
LITELLM_LOG=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=telekom-agent-showcase
